-- ALTER   VIEW [L2Brand].[VW_L2Brands_Units_Invoiced]
-- AS
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
----------VISTA PARA L2B INVOICE LCA-------------------------------------------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
----Que hace este script
------1) Toma embarques de TB_ShipmentCheckPrices desde una fecha de corte.
------2) Consolida base de facturacion historica por Waybill/Box/MO/Style/Color/Size.
------3) Cruza packed items + shipment + ordenes + estilos para construir el detalle final.
------4) Determina precio facturado segun fecha de cambio de regla.
--;
WITH CTE_Prices
AS
(
    ----Embarques a considerar para la vista (fecha de inicio de proceso)
    SELECT
          [id]
		 ,ISNULL(SCP.[Waybill], AF.[Waybill]) AS Waybill
		 ,ISNULL(SCP.[ShipDate], AF.ShipDate) AS ShipDate
	FROM
	( SELECT DISTINCT 
		Waybill
		,ShipDate
	  FROM AppsLCA.dbo.ImportExport_AnexoFacturacion AS AF WITH (NOLOCK)
      WHERE AF.ShipDate >= '2025-01-01'
      AND StyleNumber NOT IN ('-','Fabric','Trim','Supplies','SWATCH')
	) AS AF 
    LEFT JOIN AppsLCA.dbo.TB_ShipmentCheckPrices AS SCP WITH (NOLOCK) ON SCP.Waybill = AF.Waybill
    -- WHERE ISNULL(SCP.[ShipDate], AF.ShipDate) >= '2026-02-01'

	
	
),
CTE_Bill
AS
(
    ----Base de facturacion consolidada por combinacion clave
    SELECT
         [ShipDate]         = AF.[ShipDate] 
        ,[Waybill]          = AF.[Waybill]
		,[ManufactureID]    = AF.[ManufactureID]
        ,[MO]               = TMO_APri.[ManufactureNumber]
        ,[RO]               = AF.RO
        ,[OrderID]          = AF.[OrderID]
		,[StyleNumber]      = AF.[StyleNumber]
		,[StyleColor]       = AF.[StyleColor]
		,[Size]             = AF.[Size]
		,[BasePrice]        = AF.[BasePrice]
		,[TotalDecoration]  = AF.[Price] - AF.[BasePrice]
		,[UnitPrice]	    = AF.[Price]
        ,[TariffCategory]   = CASE
                                WHEN TE.ID IS NOT NULL THEN 'NO CAFTA RULE 9802'
                                WHEN COALESCE(TB_MO_Key1.[TariffCategory]
                                             ,TB_MO_Key2.[TariffCategory]
                                             ,TB_MO_Key3.[TariffCategory]
                                             ,TB_MO_Key4.[TariffCategory]
                                             ,TB_MO_Key5.[TariffCategory]
                                             ,TB_MO_2.[TariffCategory]) = 'CAFTA' THEN 'CAFTA'
                                WHEN COALESCE(TB_MO_Key1.[TariffCategory]
                                             ,TB_MO_Key2.[TariffCategory]
                                             ,TB_MO_Key3.[TariffCategory]
                                             ,TB_MO_Key4.[TariffCategory]
                                             ,TB_MO_Key5.[TariffCategory]
                                             ,TB_MO_2.[TariffCategory]) IN( 'NonCAFTA','Non CAFTA','NONCAFTA') THEN 'NO CAFTA'
                                WHEN AF.SeasonName = 'EMB FG' THEN 'NO CAFTA'
                                WHEN AF.SeasonName <> 'EMB FG' THEN 'CAFTA'
                                ELSE 'NOT FOUND'
                              END
        ,[CountryOfOrigin]  = COALESCE(TB_MO_Key1.[CountryOfOrigin]
                                        ,TB_MO_Key2.[CountryOfOrigin]
                                        ,TB_MO_Key3.[CountryOfOrigin]
                                        ,TB_MO_Key4.[CountryOfOrigin]
                                        ,TB_MO_Key5.[CountryOfOrigin]
                                        ,TB_MO_2.[CountryOfOrigin]
                                        ,CASE
                                            WHEN AF.[SeasonName] <> 'EMB FG' THEN 'El Salvador'
                                            WHEN AF.[RO] IN ('16131-32022-WHT-1','19084-144-SYH-1','19547-31014-485-1') THEN 'Pakistan'
                                            WHEN AF.[RO] = '16730-EZ100-LAB' THEN 'Honduras'
                                            WHEN AF.[StyleNumber] IN ('05PDT','10PDT','15PDT') THEN 'India'
                                          END
                                            )
        ,[US_HTSCode]       = CASE
                                    WHEN ST.[Comments9] NOT LIKE '%Head%' AND HTS.[US_HTSCode] IS NOT NULL THEN HTS.[US_HTSCode]
                                    WHEN LMN.[US_HTSCode] IS NOT NULL THEN LMN.[US_HTSCode]
                                    WHEN LMN.[CA_HTSCode] IS NOT NULL THEN LMN.[CA_HTSCode]
                                    WHEN HTS.[US_HTSCode] IS NOT NULL THEN HTS.[US_HTSCode]
                                    ELSE NULL
                              END 
        ,[StyleOption]      = AF.[StyleOptionName]
        ,[ProductDivision]  = COALESCE(IIF(AF.[ProductDivision] IN ('Accesories','Fleece'), 'Apparel',AF.[ProductDivision]), IIF(ST.[Comments9] = 'Accesories','Apparel',ST.[Comments9]))
		,[Quantity]		    = SUM(AF.[Qty])
        --SELECT SUM(AF.[Qty])
    FROM CTE_Prices AS CP
	INNER JOIN AppsLCA.dbo.ImportExport_AnexoFacturacion AS AF WITH (NOLOCK) ON CP.Waybill = AF.Waybill and CP.ShipDate = AF.ShipDate
    LEFT  JOIN 
    (SELECT ID FROM AppsLCA.dbo.TB_Transfer_Export_Duty       AS TE WITH (NOLOCK) WHERE TE.[status] = 1) AS TE ON AF.ID = TE.ID  
    LEFT JOIN
    (
        SELECT
             [ManufactureId]
            ,[CountryOfOrigin]
            ,[Manufacturer]
            ,[TariffCategory]
            ,[Category]
            ,[Style]
            ,[Color]
            ,[Size]
        FROM
        (
            SELECT
                 [ManufactureId]
                ,[CountryOfOrigin]
                ,[Manufacturer]
                ,[TariffCategory]
                ,[Category]
                ,[Style]
                ,[Color]
                ,[Size]
                ,ROW_NUMBER() OVER
                (
                    PARTITION BY [ManufactureId], [Style], [Color], [Size]
                    ORDER BY [ManufactureId], [Style], [Color], [Size], [Consumption] DESC
                ) AS Ncuenta
            FROM AppsLCA.dbo.TB_MO_PartNumber_IM_Summary WITH (NOLOCK)
            WHERE ([Size] IS NOT NULL AND RTRIM([Size]) <> '')
            --and mo in('RO123021CCW115-837-5','TO1018CCW115-837-1')  --='EO3902696-BKH' mo='EO3774316-LBL'
            GROUP BY
                 [ManufactureId]
                ,[CountryOfOrigin]
                ,[Manufacturer]
                ,[TariffCategory]
                ,[Category]
                ,[Style]
                ,[Color]
                ,[Size]
                ,[Consumption]
        ) AS TB_MO_01
        WHERE [Ncuenta] = 1
    ) AS TB_MO_Key1
        ON AF.[RO_ID]       = TB_MO_Key1.[ManufactureID]
       AND AF.[StyleNumber] = TB_MO_Key1.[Style]
       AND AF.[StyleColor]  = TB_MO_Key1.[Color]
       AND AF.[Size]        = TB_MO_Key1.[Size]
    LEFT JOIN
    (
        SELECT
             [ManufactureId]
            ,[CountryOfOrigin]
            ,[Manufacturer]
            ,[TariffCategory]
            ,[Category]
            ,[Style]
            ,[Color]
        FROM
        (
            SELECT
                 [ManufactureId]
                ,[CountryOfOrigin]
                ,[Manufacturer]
                ,[TariffCategory]
                ,[Category]
                ,[Style]
                ,[Color]
                ,ROW_NUMBER() OVER
                (
                    PARTITION BY [ManufactureId], [Style], [Color]
                    ORDER BY [ManufactureId], [Style], [Color], [Consumption] DESC
                ) AS Ncuenta
            FROM AppsLCA.dbo.TB_MO_PartNumber_IM_Summary WITH (NOLOCK)
            WHERE ([Size] IS NULL OR RTRIM([Size]) = '')
            --and mo in('RO123021CCW115-837-5','TO1018CCW115-837-1')  --='EO3902696-BKH' mo='EO3774316-LBL'
            GROUP BY
                 [ManufactureId]
                ,[CountryOfOrigin]
                ,[Manufacturer]
                ,[TariffCategory]
                ,[Category]
                ,[Style]
                ,[Color]
                ,[Consumption]
        ) AS TB_MO_01
        WHERE [Ncuenta] = 1
    ) AS TB_MO_Key2
        ON AF.[RO_ID]       = TB_MO_Key2.[ManufactureID]
       AND AF.[StyleNumber] = TB_MO_Key2.[Style]
       AND AF.[StyleColor]  = TB_MO_Key2.[Color]
    LEFT JOIN
    (
        SELECT
             [ManufactureId]
            ,[CountryOfOrigin]
            ,[Manufacturer]
            ,[TariffCategory]
            ,[Category]
            ,[Style]
        FROM
        (
            SELECT
                 [ManufactureId]
                ,[CountryOfOrigin]
                ,[Manufacturer]
                ,[TariffCategory]
                ,[Category]
                ,[Style]
                ,ROW_NUMBER() OVER
                (
                    PARTITION BY [ManufactureId], [Style]
                    ORDER BY [ManufactureId], [Style], [Consumption] DESC
                ) AS Ncuenta
            FROM AppsLCA.dbo.TB_MO_PartNumber_IM_Summary WITH (NOLOCK)
            WHERE ([Size] IS NULL OR RTRIM([Size]) = '') AND ([Color] IS NULL OR RTRIM([Color]) = '')
            --and mo in('RO123021CCW115-837-5','TO1018CCW115-837-1')  --='EO3902696-BKH' mo='EO3774316-LBL'
            GROUP BY
                 [ManufactureId]
                ,[CountryOfOrigin]
                ,[Manufacturer]
                ,[TariffCategory]
                ,[Category]
                ,[Style]
                ,[Consumption]
        ) AS TB_MO_01
        WHERE [Ncuenta] = 1
    ) AS TB_MO_Key3
        ON AF.[RO_ID]       = TB_MO_Key3.[ManufactureID]
       AND AF.[StyleNumber] = TB_MO_Key3.[Style]
    LEFT JOIN
    (
        SELECT
             [ManufactureId]
            ,[CountryOfOrigin]
            ,[Manufacturer]
            ,[TariffCategory]
            ,[Category]
        FROM
        (
            SELECT
                 [ManufactureId]
                ,[CountryOfOrigin]
                ,[Manufacturer]
                ,[TariffCategory]
                ,[Category]
                ,ROW_NUMBER() OVER
                (
                    PARTITION BY [ManufactureId]
                    ORDER BY [ManufactureId],  [Consumption] DESC
                ) AS Ncuenta
            FROM AppsLCA.dbo.TB_MO_PartNumber_IM_Summary WITH (NOLOCK)
            --and mo in('RO123021CCW115-837-5','TO1018CCW115-837-1')  --='EO3902696-BKH' mo='EO3774316-LBL'
            GROUP BY
                 [ManufactureId]
                ,[CountryOfOrigin]
                ,[Manufacturer]
                ,[TariffCategory]
                ,[Category]
                ,[Consumption]
        ) AS TB_MO_01
        WHERE [Ncuenta] = 1
    ) AS TB_MO_Key4
        ON AF.[RO_ID]       = TB_MO_Key4.[ManufactureID]

    LEFT JOIN
    (
        SELECT
             [ManufactureId]
            ,[CountryOfOrigin]
            ,[Manufacturer]
            ,[TariffCategory]
            ,[Category]
        FROM
        (
            SELECT
                 [ManufactureId]
                ,[CountryOfOrigin]
                ,[Manufacturer]
                ,[TariffCategory]
                ,[Category]
                ,ROW_NUMBER() OVER
                (
                    PARTITION BY [ManufactureId]
                    ORDER BY [ManufactureId],  [Consumption] DESC
                ) AS Ncuenta
            FROM AppsLCA.dbo.TB_MO_PartNumber_IM_Summary WITH (NOLOCK)
            --and mo in('RO123021CCW115-837-5','TO1018CCW115-837-1')  --='EO3902696-BKH' mo='EO3774316-LBL'
            GROUP BY
                 [ManufactureId]
                ,[CountryOfOrigin]
                ,[Manufacturer]
                ,[TariffCategory]
                ,[Category]
                ,[Consumption]
        ) AS TB_MO_01
        WHERE [Ncuenta] = 1
    ) AS TB_MO_Key5
        ON AF.[ManufactureID]       = TB_MO_Key5.[ManufactureID]
    
    LEFT JOIN
    (
        SELECT DISTINCT
             [ManufactureId]
            ,[CountryOfOrigin]
            ,[Manufacturer]
            ,[TariffCategory]
            ,[Category]
        FROM
        (
            SELECT *
            FROM
            (
                SELECT
                     *
                    ,ROW_NUMBER() OVER (PARTITION BY ManufactureId ORDER BY ManufactureId, Consumption DESC) AS Cuenta
                FROM appslca.dbo.TB_MO_PartNumber_IM_Summary WITH (NOLOCK)
                WHERE (Size IS NULL OR RTRIM(Size) = '')
                  AND Category = 'Fabric'
                --and mo in ('RO123021CCW115-837-5','TO1018CCW115-837-1')
            ) AS SubFabric01
            WHERE Cuenta = 1

            UNION ALL

            SELECT *
            FROM
            (
                SELECT
                     *
                    ,ROW_NUMBER() OVER (PARTITION BY ManufactureId ORDER BY ManufactureId, Consumption DESC) AS Cuenta
                FROM appslca.dbo.TB_MO_PartNumber_IM_Summary WITH (NOLOCK)
                WHERE (Size IS NULL OR RTRIM(Size) = '')
                  AND Category = 'Contracts'
                --and mo in ('RO123021CCW115-837-5','TO1018CCW115-837-1')
            ) AS SubContract
            WHERE Cuenta = 1
        ) AS TB_MO_1
        --where TB_MO_1.ncuenta=1
    ) AS TB_MO_2
        ON AF.ManufactureID = TB_MO_2.ManufactureID

    LEFT JOIN
    (
        SELECT Color, Style, CA_HTSCode, US_HTSCode
        FROM
        (
            SELECT
                 COL.ColorName                                                                                    AS Color
                ,CL.ComponentName                                                                                 AS Style
                ,DRD.DropDownValue                                                                                AS CA_HTSCode
                ,DRD.Description3                                                                                 AS US_HTSCode
                ,ROW_NUMBER() OVER (PARTITION BY COL.ColorName, CL.ComponentName
                                    ORDER BY     COL.ColorName, CL.ComponentName) AS Cuenta
            FROM [LCA].[dbo].[RawMaterials]   AS RW  WITH (NOLOCK)
            LEFT JOIN lca.dbo.Colors           AS COL WITH (NOLOCK) ON RW.ColorID     = COL.ColorID
            LEFT JOIN lca.dbo.ComponentLibrary AS CL  WITH (NOLOCK) ON RW.ComponentID = CL.ComponentID
                                                                    AND CL.ComponentCategoryID = 11
            LEFT JOIN lca.dbo.DropDownValues   AS DRD WITH (NOLOCK) ON RW.HTSCodeID   = DRD.DropDownValueID
            WHERE CL.ComponentName IS NOT NULL
              AND COL.ColorName    IS NOT NULL
        ) AS abc123
        WHERE Cuenta = 1
    ) AS lmn
        ON AF.StyleNumber = lmn.Style
       AND AF.StyleColor  = lmn.Color

    LEFT JOIN lca.dbo.ManufactureOrders  AS TMO_APri WITH (NOLOCK) ON AF.ManufactureID           = TMO_APri.ManufactureID
    LEFT JOIN lca.dbo.OrderItems         AS ODT_PRI  WITH (NOLOCK) ON TMO_APri.FirstOrderItemID   = ODT_PRI.OrderItemID
    LEFT JOIN LCA.dbo.Styles             AS ST       WITH (NOLOCK) ON ODT_PRI.StyleID             = ST.StyleID
    LEFT JOIN lca.dbo.HTSStyleCodes      AS HTS      WITH (NOLOCK) ON ST.HTSStyleCodeID            = HTS.HTSStyleCodeID

    GROUP BY
         AF.[ShipDate] 
        ,AF.[Waybill]
        ,AF.[BoxNumber]
        ,AF.[ManufactureID]
        ,AF.[OrderID]
        ,AF.[StyleNumber]
        ,AF.[StyleColor]
        ,AF.[Size]
        ,AF.[BasePrice]
		,AF.[Price]
        ,CASE
            WHEN TE.ID IS NOT NULL THEN 'NO CAFTA RULE 9802'
            WHEN COALESCE(TB_MO_Key1.[TariffCategory]
                            ,TB_MO_Key2.[TariffCategory]
                            ,TB_MO_Key3.[TariffCategory]
                            ,TB_MO_Key4.[TariffCategory]
                            ,TB_MO_Key5.[TariffCategory]
                            ,TB_MO_2.[TariffCategory]) = 'CAFTA' THEN 'CAFTA'
            WHEN COALESCE(TB_MO_Key1.[TariffCategory]
                            ,TB_MO_Key2.[TariffCategory]
                            ,TB_MO_Key3.[TariffCategory]
                            ,TB_MO_Key4.[TariffCategory]
                            ,TB_MO_Key5.[TariffCategory]
                            ,TB_MO_2.[TariffCategory]) IN( 'NonCAFTA','Non CAFTA','NONCAFTA') THEN 'NO CAFTA'
            WHEN AF.SeasonName = 'EMB FG' THEN 'NO CAFTA'
            WHEN AF.SeasonName <> 'EMB FG' THEN 'CAFTA'
            ELSE 'NOT FOUND'
          END
        ,COALESCE(TB_MO_Key1.[CountryOfOrigin]
          ,TB_MO_Key2.[CountryOfOrigin]
          ,TB_MO_Key3.[CountryOfOrigin]
          ,TB_MO_Key4.[CountryOfOrigin]
          ,TB_MO_Key5.[CountryOfOrigin]
          ,TB_MO_2.[CountryOfOrigin]
          ,CASE
              WHEN AF.[SeasonName] <> 'EMB FG' THEN 'El Salvador'
              WHEN AF.[RO] IN ('16131-32022-WHT-1','19084-144-SYH-1','19547-31014-485-1') THEN 'Pakistan'
              WHEN AF.[RO] = '16730-EZ100-LAB' THEN 'Honduras'
              WHEN AF.[StyleNumber] IN ('05PDT','10PDT','15PDT') THEN 'India'
            END
              )
        ,AF.[StyleOptionName]
        ,TMO_APri.[ManufactureNumber]
        ,AF.RO
        ,CASE
            WHEN ST.[Comments9] NOT LIKE '%Head%' AND HTS.[US_HTSCode] IS NOT NULL THEN HTS.[US_HTSCode]
            WHEN LMN.[US_HTSCode] IS NOT NULL THEN LMN.[US_HTSCode]
            WHEN LMN.[CA_HTSCode] IS NOT NULL THEN LMN.[CA_HTSCode]
            WHEN HTS.[US_HTSCode] IS NOT NULL THEN HTS.[US_HTSCode]
            ELSE NULL
         END
        ,COALESCE(IIF(AF.[ProductDivision] IN ('Accesories','Fleece'), 'Apparel',AF.[ProductDivision]), IIF(ST.[Comments9] = 'Accesories','Apparel',ST.[Comments9]))
)
-- select * from CTE_Bill
,
CTE_L2BrandInv
AS
(
	SELECT
		Style
		,Color
		,Size
		,InvItemID
		,ROW_NUMBER() OVER(PARTITION BY Style, Color, Size ORDER BY Style, Color, Size) AS R
	FROM AppsLCA.legacycaps.VW_LCA_L2B_InventoryID AS L2BInv WITH(NOLOCK)
),
CTE_Orders AS
(
    SELECT 
         OrderID
        ,CASE
            WHEN PONumber LIKE 'ORD-PO%' THEN NULL
            WHEN PONumber LIKE 'ORD-%'   THEN TRY_CAST(REPLACE(PONumber,'ORD-','') AS BIGINT)
            WHEN PONumber LIKE 'ORD%'    THEN TRY_CAST(Comments6 AS BIGINT)
            ELSE NULL
         END AS ItemDetailID_Calc
        ,CASE
            WHEN PONumber LIKE 'ORD%' AND CHARINDEX('-', Comments6) > 0
                THEN SUBSTRING(Comments6, 1, CHARINDEX('-', Comments6) - 1)
            ELSE Comments6
         END AS CustomerPO_Calc
    FROM LCA.dbo.Orders WITH(NOLOCK)
),
CTE_Final
AS
(
    SELECT
        [Size]						 = AF.Size
        ,[StyleColor]				 = AF.StyleColor
        ,[Quantity]					 = SUM(AF.Quantity)
        ,[Style]					 = AF.StyleNumber
        ,[StyleID]					 = COALESCE(SCPD.StyleID, OI.StyleID)
        ,[TransactionDate]			 = SCP.ShipDate
        ,[MO]						 = MO.ManufactureNumber
        ,[MO_ID]					 = AF.ManufactureID
        ,[ItemDetailID]				 = COALESCE(SCPD.ItemDetailID, OD.ItemDetailID_Calc)
        ,[Item #]					 = L2BInv.InvItemID
        ,[InvoicedPrice]			 = CASE
									     WHEN SCP.ShipDate < '2026-02-10' THEN AF.BasePrice
									     ELSE SCPD.TotalBlank
									   END
		,[Decoration_Invoiced_Price] = CASE
									     WHEN SCP.ShipDate < '2026-02-10' THEN AF.[TotalDecoration]
									     ELSE SCPD.TotalDecoration
									   END
		,[Unit_Invoiced_Price]		 = CASE
									     WHEN SCP.ShipDate < '2026-02-10' THEN AF.UnitPrice
									     ELSE SCPD.TotalBlank + SCPD.TotalDecoration
									   END
		
        ,[CustomerPO]				 = OD.[CustomerPO_Calc]
        ,[StyleOption]				 = AF.StyleOption
        ,[Waybill]					 = AF.Waybill
        ,[TariffCategory]            = AF.[TariffCategory]
         --,[StyleOptionID] = SCPD.StyleOptionID
         --,[Season]        = SCPD.Season
    FROM CTE_Prices										AS SCP    WITH(NOLOCK)
    LEFT JOIN  CTE_Bill									AS AF     WITH(NOLOCK) ON  SCP.waybill							= AF.Waybill and SCP.ShipDate = AF.ShipDate
    LEFT JOIN  AppsLCA.dbo.TB_ShipmentCheckPricesDetail AS SCPD   WITH(NOLOCK) ON  SCP.ID								= SCPD.shipmentCheckPrices_id 
																			   AND SCPD.ManufactureID					= AF.ManufactureID
    LEFT JOIN   CTE_Orders                              AS OD     WITH(NOLOCK) ON  AF.OrderID = OD.OrderID
    INNER JOIN  LCA.dbo.ManufactureOrders               AS MO     WITH(NOLOCK) ON  AF.ManufactureID                    = MO.ManufactureID
    INNER JOIN  LCA.dbo.OrderItems                      AS OI     WITH(NOLOCK) ON  MO.FirstOrderItemID                 = OI.OrderItemID
    INNER JOIN  LCA.dbo.Styles							AS ST     WITH(NOLOCK) ON  ST.StyleID							= OI.StyleID
    LEFT JOIN  LCA.dbo.Styles							AS STB    WITH(NOLOCK) ON  STB.StyleID							= ST.BlankStyleID
    LEFT JOIN  CTE_L2BrandInv							AS L2BInv WITH(NOLOCK) ON  COALESCE(STB.StyleNumber, SCPD.Style, AF.StyleNumber) = L2BInv.Style
																				AND COALESCE(SCPD.Color,AF.StyleColor)	= L2BInv.Color
																				AND AF.Size								= L2BInv.[Size]
																				AND L2BInv.R							= 1
    GROUP BY
         AF.Size
        ,AF.StyleColor
        ,AF.StyleNumber
        ,COALESCE(SCPD.StyleID, OI.StyleID)
        ,SCP.ShipDate
        ,MO.ManufactureNumber
        ,AF.ManufactureID
        ,COALESCE(SCPD.ItemDetailID, OD.ItemDetailID_Calc)
        ,L2BInv.InvItemID
        ,CASE
            WHEN SCP.ShipDate < '2026-02-10' THEN AF.BasePrice
            ELSE SCPD.TotalBlank
         END
        ,CASE
            WHEN SCP.ShipDate < '2026-02-10' THEN AF.[TotalDecoration]
            ELSE SCPD.TotalDecoration
         END
        ,CASE
            WHEN SCP.ShipDate < '2026-02-10' THEN AF.UnitPrice
            ELSE SCPD.TotalBlank + SCPD.TotalDecoration
         END
        ,OD.[CustomerPO_Calc]
        ,AF.StyleOption
        ,AF.Waybill
        ,AF.[TariffCategory]
        )

SELECT 
     [Size]
    ,[StyleColor]
    ,[Quantity]
    ,[Style]
    ,[StyleID]
    ,[TariffCategory]
    ,[TransactionDate]
    ,[MO]
    ,[MO_ID]
    ,[ItemDetailID]
    ,[Item #]
    ,[InvoicedPrice] as Blank_Invoiced_Price
    ,[CustomerPO]
    ,[StyleOption]
    ,[Waybill]
	,[Decoration_Invoiced_Price]
	,[Unit_Invoiced_Price]
	
FROM CTE_Final
